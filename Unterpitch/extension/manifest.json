{
  "manifest_version": 3,
  "name": "Rehearsal Coach",
  "version": "0.1.0",
  "description": "Offline, slide-aware presentation rehearsal coach for German and English. Audio is processed locally and never leaves your device.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open Rehearsal Coach", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "https://docs.google.com/presentation/*",
    "https://*.googleusercontent.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" }
}
